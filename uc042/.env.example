# Template only (no real values). Copy to .env (uc042/.env, git-ignored) and fill in your own key.
# uc042lib/investigation/config.py loads .env automatically; variables already set in the process environment win.
UC042_LLM_PROVIDER=openai               # openai (live, default) | anthropic (live, legacy) | offline (SIMULATED, tests only)
UC042_LLM_MODEL=gpt-6-luna              # project default; any model your OpenAI account can use
UC042_LLM_TIMEOUT_SECONDS=120           # per provider request
UC042_LLM_MAX_TOKENS=8000               # max_output_tokens (reasoning tokens count towards it)
UC042_OPENAI_REASONING_EFFORT=medium    # optional: none|minimal|low|medium|high|xhigh|max; leave blank to use the model default
OPENAI_API_KEY=                         # required only for live investigations; never commit a real key

# OpenAI is the only live provider. There is no automatic fallback provider (Groq was removed on 12 Nov 2026):
# a failed OpenAI request is reported as it failed. UC042_LLM_FALLBACK_* and GROQ_* are no longer read.
UC042_INVESTIGATION_MODE=fixed          # fixed (V1, default) | tools (V2 bounded tool calling; openai only)
# Optional:
# UC042_LLM_TOTAL_TIMEOUT_SECONDS=300   # wall-clock budget for one investigation (both modes)
# UC042_TOOLS_MAX_CALLS=8               # tools mode: tool calls per investigation (rejected and duplicates count)
# UC042_TOOLS_MAX_ROUNDS=4              # tools mode: model -> tools -> model rounds
# UC042_TOOLS_MAX_RECORDS_PER_CALL=25   # tools mode: records returned per tool call
# UC042_TOOLS_MAX_INPUT_TOKENS=150000   # tools mode: estimated input tokens per request
# ANTHROPIC_API_KEY=                    # only for UC042_LLM_PROVIDER=anthropic (legacy adapter)

# ---- Backend (uc042app) persistence: Phase 4 ----------------------------------------------------------------------
# PostgreSQL database for application state and monthly document management (pure-Python driver pg8000).
# Leave unset to run the backend on file-backed state only (no monthly archive or upload features).
# Create the schema with:  .venv\Scripts\python.exe -m uc042app.admin db-upgrade
# UC042_DATABASE_URL=postgresql+pg8000://uc042:<password>@127.0.0.1:5433/uc042
# Separate, disposable database used ONLY by the backend tests (emptied before tests); never the database above.
# UC042_TEST_DATABASE_URL=postgresql+pg8000://uc042:<password>@127.0.0.1:5433/uc042_test
# Uploaded original documents (content-addressed) and processing case folders. Must be outside packs/, investigations/,
# final_packs/ and uc042_dataset/. Default: uc042/document_store
# UC042_DOCUMENT_STORE=
# UC042_APP_STATE_DIR=                  # default uc042/app_state (instance lock; file-backed state when no database)

# ---- Investigation input roots (uc042lib/investigation/roots.py) ----------------------------------------------------
# Profiles: september (packs/, uc042_dataset/; PER-2026-09, the default) and historical-demo (demo_history/packs,
# demo_history/datasets; PER-2026-01..08). Select by profile or by period; the CLI also takes --profile / --period.
# Never point a root at demo_history/ itself: it contains verification/ (expected-answer material); such a root is refused.
# UC042_INVESTIGATION_PROFILE=historical-demo
# UC042_INVESTIGATION_PERIOD=PER-2026-03
# Backend: the source datasets of the packs in UC042_PACKS_ROOT (default uc042_dataset/). Validated at start-up.
# UC042_DATASETS_ROOT=

# ---- Published final audit packs and their PDF (Phase 10) ------------------------------------------------------------
# Primary (operational) final packs are runtime OUTPUT and must be OUTSIDE the source repository: the backend refuses to
# start with a root inside it. Set an absolute, backed-up directory for the deployment. When unset the default is the
# per-user data directory: %LOCALAPPDATA%\UC042\final_packs (Windows) or $XDG_DATA_HOME/uc042/final_packs
# (~/.local/share/uc042/final_packs). The directory is created on first publication. Historical-demo final packs keep
# their fixed location (demo_history/final_packs) and are never moved. The tests always use a temporary directory.
# UC042_FINAL_PACKS_ROOT=D:\UC042\final_packs
# Unicode PDFs (renderer 2.0-unicode) use the bundled DejaVu fonts (uc042lib/final_pack/fonts, licence included). For
# scripts DejaVu does not cover (CJK, emoji), list licensed fallback .ttf/.ttc files, separated by ';' (Windows) or ':'.
# A character no configured font can draw is never substituted: the preview and GENERATE stop with an explicit error.
# The same fonts must be available wherever a published pack is verified (their SHA-256 is in each manifest).
# UC042_PDF_FALLBACK_FONTS=

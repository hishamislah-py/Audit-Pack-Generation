diff -ruN --strip-trailing-cr '--exclude=__pycache__' '--exclude=*.pyc' tests/test_stage1_parity_equivalence.py tests/test_stage1_parity_equivalence.py
--- tests/test_stage1_parity_equivalence.py	1970-01-01 05:30:00.000000000 +0530
+++ tests/test_stage1_parity_equivalence.py	2026-11-16 16:20:42.719712900 +0530
@@ -0,0 +1,147 @@
+"""Stage 1 (owner-approved, 16 Nov 2026): the narrow settlement_line_to_transaction semantic equivalence in the parity
+harness (tests/det_parity.py only; production retrieval unchanged, rule stays 1.3).
+
+The model's follow_relationship query {evidence_id IN-13:SL-SB-GBP-20260915-0003, relationship settlement_line_to_transaction,
+value TX-0915-00009} and the deterministic search {file IN-11, txn_id TX-0915-00009} are the same primary-key lookup of
+IN-11 for the same line's txn_id. Positive case on the real data; negative cases for every way the match must fail.
+Offline and read-only. Run: python -m unittest tests.test_stage1_parity_equivalence -v"""
+import copy
+import unittest
+
+from tests import det_parity
+from uc042lib.investigation import det_retrieval as det
+from uc042lib.investigation.packet import build_case, build_packet, build_scope, retrieve
+from uc042lib.investigation.retrieval import EvidenceStore, load_pack
+from uc042lib.investigation.routing import route_for
+
+PACK_ID, EXC = "PACK-CASE-PER-2026-09-109a585702ae", "EXC-CASE-01"
+LINE, TX = "IN-13:SL-SB-GBP-20260915-0003", "TX-0915-00009"
+MODEL = {"search_id": "SEARCH-08", "result": "NOT_FOUND",
+         "query": {"evidence_id": LINE, "relationship": "settlement_line_to_transaction", "value": TX}}
+
+
+def real():
+    for _, _, pr, dr in det_parity.STORES:
+        try:
+            pack = load_pack(PACK_ID, pr)
+            return pack, EvidenceStore(pack, dr)
+        except Exception:  # noqa: BLE001 - try the next store
+            continue
+    return None, None
+
+
+class Stage1Equivalence(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.pack, cls.store = real()
+        if cls.store is None:
+            raise unittest.SkipTest("Clone E CASE pack not present")
+        case = build_case(cls.pack, EXC)
+        route = route_for(case["exception"], case["candidates"], case["results"])
+        col = retrieve(route, case, cls.store)
+        reg = det.expand(col, case, route, cls.store)
+        cls.packet = det.finalise_packet(build_packet(case, build_scope(case), route, col), reg)
+
+    def mutated(self, **query):
+        m = copy.deepcopy(MODEL)
+        m["query"].update(query)
+        return m
+
+    # ---------------------------------------------------------------- evidence that the equivalence is real
+    def test_source_data_establishes_the_equivalence(self):
+        line = self.store.get(LINE, "probe")
+        self.assertEqual((line["file_id"], line["fields"]["txn_id"]), ("IN-13", TX))
+        self.assertIsNone(self.store.get(f"IN-11:{TX}", "probe"))  # the transaction is not in IN-11
+        self.assertEqual(self.store.pk_of["IN-11"], "txn_id")
+        from uc042lib.investigation.tools import RELATIONSHIPS
+        self.assertEqual(RELATIONSHIPS["settlement_line_to_transaction"][:4], ("IN-13", "txn_id", "IN-11", "pk"))
+        hit = [s for s in self.packet["searches"] if s["query"] == {"file": "IN-11", "txn_id": TX}]
+        self.assertEqual([s["result"] for s in hit], ["NOT_FOUND"])
+        self.assertIn(LINE, {r["evidence_id"] for r in self.packet["source_records"]})
+        self.assertEqual(self.packet["retrieval_rule_version"], "uc042-det-retrieval/1.3")  # production rule unchanged
+
+    # ---------------------------------------------------------------- positive
+    def test_approved_case_matches_by_equivalence_not_exactly(self):
+        self.assertFalse(det_parity.not_found_covered(MODEL, self.packet["searches"]))  # exact match still fails
+        self.assertTrue(det_parity.not_found_equivalent(MODEL, self.packet, self.store))
+        self.assertEqual(det_parity.relationship_equivalent_query(MODEL["query"], self.store),
+                         det_parity.full_query({"file": "IN-11", "txn_id": TX}))
+
+    # ---------------------------------------------------------------- negatives
+    def test_transaction_id_differs(self):
+        self.assertFalse(det_parity.not_found_equivalent(self.mutated(value="TX-0915-00008"), self.packet, self.store))
+
+    def test_settlement_line_differs(self):
+        for other in ("IN-13:SL-SB-GBP-20260915-0002", "IN-13:SL-SB-GBP-20260915-9999", ""):
+            with self.subTest(other):
+                self.assertFalse(det_parity.not_found_equivalent(self.mutated(evidence_id=other), self.packet, self.store))
+
+    def test_relationship_type_differs(self):
+        for rel in ("transaction_to_batch", "settlement_line_to_batch", "refund_to_original_transaction", "unknown"):
+            with self.subTest(rel):
+                self.assertFalse(det_parity.not_found_equivalent(self.mutated(relationship=rel), self.packet, self.store))
+
+    def test_file_differs(self):
+        p = copy.deepcopy(self.packet)
+        for s in p["searches"]:
+            if s["query"] == {"file": "IN-11", "txn_id": TX}:
+                s["query"] = {"file": "IN-12", "txn_id": TX}
+        self.assertFalse(det_parity.not_found_equivalent(MODEL, p, self.store))
+
+    def test_deterministic_result_found_does_not_match(self):
+        p = copy.deepcopy(self.packet)
+        for s in p["searches"]:
+            if s["query"] == {"file": "IN-11", "txn_id": TX}:
+                s["result"] = "FOUND"
+        self.assertFalse(det_parity.not_found_equivalent(MODEL, p, self.store))
+
+    def test_partial_identifier_does_not_match(self):
+        for v in ("TX-0915-0000", "TX-0915-000090", "0915-00009", TX.lower(), f" {TX}"):
+            with self.subTest(v):
+                self.assertFalse(det_parity.not_found_equivalent(self.mutated(value=v), self.packet, self.store))
+        p = copy.deepcopy(self.packet)  # deterministic query with an extra key is not the same query
+        for s in p["searches"]:
+            if s["query"] == {"file": "IN-11", "txn_id": TX}:
+                s["query"] = {"file": "IN-11", "txn_id": TX, "client_id": "C0002"}
+        self.assertFalse(det_parity.not_found_equivalent(MODEL, p, self.store))
+
+    def test_extra_or_missing_query_keys_do_not_match(self):
+        m = copy.deepcopy(MODEL)
+        m["query"]["currency"] = "GBP"
+        self.assertFalse(det_parity.not_found_equivalent(m, self.packet, self.store))
+        m = copy.deepcopy(MODEL)
+        del m["query"]["value"]
+        self.assertFalse(det_parity.not_found_equivalent(m, self.packet, self.store))
+
+    def test_line_missing_from_the_deterministic_packet_does_not_match(self):
+        p = copy.deepcopy(self.packet)
+        p["source_records"] = [r for r in p["source_records"] if r["evidence_id"] != LINE]
+        self.assertFalse(det_parity.not_found_equivalent(MODEL, p, self.store))
+
+    def test_transaction_id_alone_never_matches(self):
+        """A search for the same txn_id is not enough: the line, relationship and file must all agree."""
+        bare = {"search_id": "X", "result": "NOT_FOUND", "query": {"txn_id": TX}}
+        self.assertFalse(det_parity.not_found_equivalent(bare, self.packet, self.store))
+        self.assertFalse(det_parity.not_found_covered(bare, self.packet["searches"]))
+
+
+class Stage1ParitySummary(unittest.TestCase):
+    def test_96_of_96_with_one_separately_reported_semantic_match(self):
+        excluded = []
+        rows = det_parity.run(excluded)
+        s = det_parity.summary(rows, excluded)
+        self.assertEqual((s["not_found_covered"], s["not_found_searches_cited"]), (96, 96))
+        self.assertEqual(s["not_found_covered_exact"], 95)
+        self.assertEqual(len(s["not_found_semantic_matches"]), 1)
+        m = s["not_found_semantic_matches"][0]
+        self.assertEqual((m["store"], m["exception_id"], m["search_id"], m["matched_by"]),
+                         ("clone-e", "EXC-CASE-01", "SEARCH-08", "approved semantic equivalence"))
+        self.assertEqual(m["equivalent_query"], {"file": "IN-11", "txn_id": TX})
+        self.assertEqual(s["not_found_missed"], [])
+        self.assertEqual((s["covered"], s["cited_model_fetched_records"]), (162, 162))
+        self.assertEqual(s["distinct_per_exception"], {"targets": 77, "covered": 77})
+        self.assertEqual(s["retrieval_rule_versions"], ["uc042-det-retrieval/1.3"])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff -ruN --strip-trailing-cr '--exclude=__pycache__' '--exclude=*.pyc' tests/test_stage2_exact_reconstruction.py tests/test_stage2_exact_reconstruction.py
--- tests/test_stage2_exact_reconstruction.py	1970-01-01 05:30:00.000000000 +0530
+++ tests/test_stage2_exact_reconstruction.py	2026-11-16 16:24:46.117759700 +0530
@@ -0,0 +1,135 @@
+"""Stage 2 (DR-05): the model view preserves the original packet ordering, so reconstruct_packet(render_model_view(p)) is
+EXACTLY the stored packet and its SHA-256, computed with the existing convention (packet.py: sha256 of
+uc042lib.pack.model.canonical(packet without packet_sha256)), equals packet_sha256. Model view 1.2.
+
+The 57 packets whose hash could not be reproduced under view 1.1 (source_records 57, relationships 56, control_results 39
+out of order) are covered by the all-packet tests below; their count is pinned. Offline and read-only.
+Run: python -m unittest tests.test_stage2_exact_reconstruction -v"""
+import copy
+import hashlib
+import json
+import unittest
+
+from tests.view_fixtures import all_packets
+from uc042lib.investigation import det_retrieval as det
+from uc042lib.investigation.packet import build_packet, build_scope, retrieve
+from uc042lib.investigation.packet_view import MODEL_VIEW_VERSION, model_view_text, reconstruct_packet, render_model_view
+from uc042lib.pack.model import canonical
+
+PACKETS = list(all_packets())
+ORDERED = ("source_records", "relationships", "control_results")
+
+
+def packet_hash(p):
+    """The existing convention (packet.build_packet / det_retrieval.finalise_packet), unchanged."""
+    return hashlib.sha256(canonical({k: v for k, v in p.items() if k != "packet_sha256"}).encode("utf-8")).hexdigest()
+
+
+def round_trip(p):
+    return reconstruct_packet(json.loads(model_view_text(p)))  # through the exact text sent to the model
+
+
+def det_packets():
+    for label, _, _, _, store, case, route in PACKETS:
+        if det.supported(route):
+            col = retrieve(route, case, store)
+            reg = det.expand(col, case, route, store)
+            yield label, det.finalise_packet(build_packet(case, build_scope(case), route, col), reg)
+
+
+class ExactReconstruction(unittest.TestCase):
+    def test_version_is_1_2(self):
+        self.assertEqual(MODEL_VIEW_VERSION, "uc042-model-view/1.2")
+
+    def test_all_76_packets_reconstruct_exactly_with_matching_hashes(self):
+        self.assertEqual(len(PACKETS), 76)
+        exact = hashes = 0
+        for label, _, _, p, *_ in PACKETS:
+            with self.subTest(label):
+                self.assertEqual(packet_hash(p), p["packet_sha256"])  # the convention reproduces the stored hash
+                r = round_trip(p)
+                self.assertEqual(r, p)  # every value, every list in its original order
+                for k in ORDERED:
+                    self.assertEqual([json.dumps(x, sort_keys=True) for x in r[k]], [json.dumps(x, sort_keys=True) for x in p[k]], k)
+                self.assertEqual(packet_hash(r), p["packet_sha256"])
+                self.assertEqual(r["packet_sha256"], p["packet_sha256"])
+                exact += r == p
+                hashes += packet_hash(r) == p["packet_sha256"]
+        self.assertEqual((exact, hashes), (76, 76))
+
+    def test_the_57_view_1_1_ordering_failures_are_covered(self):
+        """Packets whose stored order differs from the view's sorted layout (the 57 hash failures of view 1.1)."""
+        reordered = []
+        for label, _, _, p, *_ in PACKETS:
+            recs_sorted = sorted(p["source_records"], key=lambda r: (r["file_id"], r["evidence_id"]))
+            if recs_sorted != p["source_records"]:
+                reordered.append(label)
+                self.assertEqual(round_trip(p), p, label)
+        self.assertEqual(len(reordered), 57)
+
+    def test_deterministic_packets_reconstruct_exactly(self):
+        n = 0
+        for label, p in det_packets():
+            n += 1
+            with self.subTest(label):
+                self.assertEqual(packet_hash(p), p["packet_sha256"])
+                r = round_trip(p)
+                self.assertEqual(r, p)
+                self.assertEqual(packet_hash(r), p["packet_sha256"])
+        self.assertEqual(n, 53)
+
+    def test_view_is_deterministic(self):
+        for label, _, _, p, *_ in PACKETS[:20]:
+            self.assertEqual(model_view_text(p), model_view_text(copy.deepcopy(p)), label)
+
+    def test_token_reduction_is_preserved(self):
+        raw = sum(len(json.dumps(p, sort_keys=True, ensure_ascii=False)) for _, _, _, p, *_ in PACKETS)
+        view = sum(len(model_view_text(p)) for _, _, _, p, *_ in PACKETS)
+        self.assertLess(view, raw * 0.80, f"{raw} -> {view}")  # still at least 20% smaller than the raw packet JSON
+
+
+class OrderingEdgeCases(unittest.TestCase):
+    """Synthetic orderings built from a real packet (no historical file is touched)."""
+
+    def base(self):
+        return copy.deepcopy(next(p for label, _, _, p, *_ in PACKETS if "SC3C" in label))
+
+    def check(self, p):
+        r = round_trip(p)
+        self.assertEqual(r, p)
+        return r
+
+    def test_reversed_lists(self):
+        p = self.base()
+        for k in ORDERED:
+            p[k] = list(reversed(p[k]))
+        self.check(p)
+
+    def test_derived_edges_out_of_derivation_order_and_interleaved(self):
+        p = self.base()
+        rels = p["relationships"]
+        p["relationships"] = rels[1::2] + rels[0::2]
+        self.check(p)
+
+    def test_empty_relationships_and_single_record(self):
+        p = self.base()
+        p["source_records"] = p["source_records"][:1]
+        p["relationships"] = []
+        self.check(p)
+
+    def test_tampered_order_fails_closed(self):
+        p = self.base()
+        v = json.loads(model_view_text(p))
+        v["relationship_order"] = v["relationship_order"][:-1]  # one edge unaccounted for
+        with self.assertRaises(ValueError):
+            reconstruct_packet(v)
+        v = json.loads(model_view_text(p))
+        t = next(iter(v["records_by_file"].values()))
+        i = t["columns"].index("packet_order")
+        t["rows"][0][i] = t["rows"][-1][i] if len(t["rows"]) > 1 else 999  # duplicate / impossible position
+        with self.assertRaises(ValueError):
+            reconstruct_packet(v)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff -ruN --strip-trailing-cr '--exclude=__pycache__' '--exclude=*.pyc' tests/test_stage3_dr04_amounts.py tests/test_stage3_dr04_amounts.py
--- tests/test_stage3_dr04_amounts.py	1970-01-01 05:30:00.000000000 +0530
+++ tests/test_stage3_dr04_amounts.py	2026-11-16 16:32:04.108839800 +0530
@@ -0,0 +1,134 @@
+"""Stage 3 (DR-04): verified-link amounts are compared only on genuine one-to-one links (the source has exactly one target
+and the target exactly one source, for that relationship), using SIGNED values (each record's own direction field gives
+the sign; a missing or unknown direction means no comparison). Part-to-whole relationships are never compared. The links
+themselves (tools.RELATIONSHIPS) are unchanged. Offline. Run: python -m unittest tests.test_stage3_dr04_amounts -v"""
+import unittest
+from pathlib import Path
+
+from tests.view_fixtures import all_packets
+from uc042lib.investigation import tools
+from uc042lib.investigation.packet_view import verified_links
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def rec(fid, pk, **fields):
+    return {"evidence_id": f"{fid}:{pk}", "file_id": fid, "fields": fields}
+
+
+def packet(*records):
+    return {"source_records": list(records), "control_results": []}
+
+
+def rows_of(p, name):
+    return [r for r in verified_links(p)["rows"] if r[0] == name]
+
+
+def batch(bid, amount, direction, ref="REF-1", acct="SGA-GBP-01"):
+    return rec("IN-12", bid, batch_id=bid, account_id=acct, expected_bank_reference=ref, net_amount_reported=amount, direction=direction)
+
+
+def bank(beid, amount, dc, ref="REF-1", acct="SGA-GBP-01"):
+    return rec("IN-09", beid, bank_entry_id=beid, account_id=acct, bank_reference=ref, end_to_end_ref="", amount=amount, dc_indicator=dc)
+
+
+def cash(leid, amount, dc, ref="REF-1", acct="SGA-GBP-01"):
+    return rec("IN-10", leid, ledger_entry_id=leid, account_id=acct, payment_reference=ref, amount=amount, dc_indicator=dc)
+
+
+class SignedOneToOne(unittest.TestCase):
+    def test_matching_one_to_one_amounts_agree(self):
+        for p, name, want in (
+                (packet(batch("SB-1", "100.00", "TO_FIRM"), bank("BE-1", "100.00", "C")), "settlement_batch_to_bank_entry", ["100.00", "100.00", True]),
+                (packet(batch("SB-1", "100.00", "FROM_FIRM"), bank("BE-1", "100.00", "D")), "settlement_batch_to_bank_entry", ["-100.00", "-100.00", True]),
+                (packet(cash("LE-1", "50.25", "D"), bank("BE-1", "50.25", "C")), "cashbook_to_bank_entry", ["50.25", "50.25", True]),
+                (packet(rec("IN-13", "SL-1", line_id="SL-1", txn_id="TX-1", amount="9.99", dc_indicator="D"),
+                        rec("IN-11", "TX-1", txn_id="TX-1", amount="9.99", direction="DR")), "settlement_line_to_transaction", ["-9.99", "-9.99", True])):
+            with self.subTest(name, want=want):
+                self.assertEqual([r[4] for r in rows_of(p, name)], [want])
+
+    def test_opposite_signed_amounts_do_not_agree(self):
+        """Equal magnitudes in opposite directions: under 1.1 (absolute values) these 'agreed'."""
+        cases = ((packet(batch("SB-1", "100.00", "TO_FIRM"), bank("BE-1", "100.00", "D")), "settlement_batch_to_bank_entry"),
+                 (packet(cash("LE-1", "50.25", "D"), bank("BE-1", "50.25", "D")), "cashbook_to_bank_entry"),
+                 (packet(rec("IN-13", "SL-1", line_id="SL-1", txn_id="TX-1", amount="9.99", dc_indicator="D"),
+                         rec("IN-11", "TX-1", txn_id="TX-1", amount="9.99", direction="CR")), "settlement_line_to_transaction"))
+        for p, name in cases:
+            with self.subTest(name):

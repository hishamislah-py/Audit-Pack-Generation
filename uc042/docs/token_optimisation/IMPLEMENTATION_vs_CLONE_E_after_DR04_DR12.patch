+// Stage 6, DR-11: a provider (model) refusal is not an application validation failure. readableFailure() says the model
+// declined to answer; validation refusals keep their own explanation; unknown text keeps the generic fallback.
+import { describe, expect, it } from "vitest";
+import { readableFailure } from "../lib/labels";
+
+describe("readableFailure: provider refusals (DR-11)", () => {
+  it("explains a model refusal as a provider refusal, not validation", () => {
+    for (const technical of [
+      "LLMCallError: model refused: I can't help with that.",
+      "ai_investigation: ToolLoop[refusal]: model refused: content policy",
+      "[refusal] model refused: unable to comply",
+    ]) {
+      const text = readableFailure(technical);
+      expect(text).toMatch(/model declined to answer/);
+      expect(text).toMatch(/not a validation failure/);
+      expect(text).not.toMatch(/did not pass the application's validation/);
+    }
+  });
+
+  it("still explains application validation refusals as validation", () => {
+    expect(readableFailure("validate_findings: REJECTED: C-01 uses a missing item")).toMatch(/did not pass the application's validation/);
+    expect(readableFailure("the output was rejected by validation")).toMatch(/did not pass the application's validation/);
+    expect(readableFailure("F-04: an unverified candidate relationship is cited as confirmed evidence")).toMatch(/only be discussed as hypotheses/);
+    expect(readableFailure("F-05: establishes states a cause ('due to')")).toMatch(/cause as a confirmed fact/);
+  });
+
+  it("keeps the other known kinds and the generic fallback", () => {
+    expect(readableFailure("ToolLoop[max_output_tokens]: response incomplete")).toMatch(/output limit/);
+    expect(readableFailure("[model_unavailable] OpenAI API error 404 (model_not_found)")).toMatch(/not available/);
+    expect(readableFailure("something new")).toMatch(/did not produce a usable result/);
+  });
+});

+// Secondary UI fixes on the exception workspace: DEF-05 (mandatory wording), DEF-06 (the engine's candidate relationship
+// shown, labelled UNVERIFIED, even without a published AI investigation), DEF-08 (missing evidence stated).
+import { cleanup, screen, within } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { Evidence } from "../api/types";
+import { PACKS, mockSource, renderApp } from "./support";
+
+const T = { timeout: 15000 };
+afterEach(() => { cleanup(); vi.restoreAllMocks(); });
+
+function backendSource(evidence: Partial<Evidence>) {
+  const source = mockSource();
+  Object.assign(source, { capabilities: { activity: true, upload: true, realInvestigations: true, realGeneration: true } });
+  vi.spyOn(source, "sourceEvidence").mockResolvedValue({
+    pack_id: PACKS.SC2, exception_id: "EXC-SC2-01", source: "deterministic_retrieval", route: "x", sha256: "s", total_records: 0, offset: 0,
+    limit: 0, source_records: [], searches: [], relationships: [], control_results: [], conflicts: [], missing_evidence: [],
+    candidate_relationships: [], allowed_citation_ids: [], ...evidence } as unknown as Evidence);
+  return source;
+}
+
+describe("Exception summary", () => {
+  it("states that AI investigation is mandatory, never optional", async () => {
+    renderApp(`/packs/${PACKS.SC2}/workspace/EXC-SC2-01`, backendSource({}));
+    const summary = await screen.findByRole("region", { name: "Exception summary" }, T);
+    expect(within(summary).getByText(/Mandatory: every exception of a processed pack is investigated automatically/)).toBeInTheDocument();
+    expect(within(summary).queryByText(/^Optional\./)).toBeNull();
+    const panel = await screen.findByRole("region", { name: "AI investigation" }, T);
+    expect(within(panel).getByText(/Mandatory AI investigation/)).toBeInTheDocument();
+  });
+
+  it("shows the engine's candidate relationship as UNVERIFIED", async () => {
+    renderApp(`/packs/${PACKS.SC2}/workspace/EXC-SC2-01`, backendSource({ candidate_relationships: [{
+      candidate_id: "CAND-SC2-01", exception_ids: "EXC-SC2-01; EXC-SC2-02", basis: "DATE_AND_AMOUNT_COINCIDENCE",
+      detail: "Amounts and dates coincide.", label: "UNVERIFIED — NOT EVIDENCE-BACKED" }] }));
+    const block = await screen.findByRole("generic", { name: "Unverified candidate relationships" }, T).catch(() => null)
+      ?? await screen.findByLabelText("Unverified candidate relationships", undefined, T);
+    expect(within(block).getByText("UNVERIFIED — NOT EVIDENCE-BACKED")).toBeInTheDocument();
+    expect(within(block).getByText("CAND-SC2-01")).toBeInTheDocument();
+    expect(within(block).getByText(/never evidence/)).toBeInTheDocument();
+  });
+});

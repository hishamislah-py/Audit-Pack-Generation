+// Secondary UI fixes DEF-07 (business labels instead of raw check codes) and DEF-10 (analyst-readable AI failures).
+import { describe, expect, it } from "vitest";
+import { CHECK_LABELS, exceptionLabel, readableFailure } from "../lib/labels";
+
+describe("exceptionLabel", () => {
+  it("maps raw check codes and keeps prose categories", () => {
+    expect(exceptionLabel("CBAL-ROLLFWD", "Requirement")).toBe("Client balance roll-forward does not agree");
+    expect(exceptionLabel("C11-BATCH-BANK")).toBe(CHECK_LABELS["C11-BATCH-BANK"]);
+    expect(exceptionLabel("CASH-BANK-LINK")).toBe("Cash-book entry not matched to a bank entry");
+    expect(exceptionLabel("Missing bank evidence")).toBe("Missing bank evidence");
+    expect(exceptionLabel("ZZ-UNKNOWN-CODE", "Control name")).toBe("Control name"); // never a guessed label
+    for (const v of Object.values(CHECK_LABELS)) expect(v).not.toMatch(/because|due to|caused/i); // labels never state a cause
+  });
+});
+
+describe("readableFailure", () => {
+  it("explains each known failure kind in plain language", () => {
+    expect(readableFailure("ai_investigation: ToolLoop[max_output_tokens]: response incomplete")).toMatch(/output limit/);
+    expect(readableFailure("F-04: an unverified candidate relationship is cited as confirmed evidence")).toMatch(/only be discussed as hypotheses/);
+    expect(readableFailure("F-05: establishes states a cause ('due to')")).toMatch(/cause as a confirmed fact/);
+    expect(readableFailure("[model_unavailable] OpenAI API error 404 (model_not_found)")).toMatch(/not available/);
+    expect(readableFailure("input_token_budget: estimated request input")).toMatch(/no request was sent/);
+    expect(readableFailure("")).toMatch(/did not produce a usable result/);
+  });
+});

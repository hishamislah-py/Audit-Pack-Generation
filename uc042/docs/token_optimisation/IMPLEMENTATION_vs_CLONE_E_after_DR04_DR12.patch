+# ---------------------------------------------------------------------------------------------------------- DR-03
+SIX = {"IN-13:SL-AQ-GBP-20260917-0005", "IN-13:SL-AQ-GBP-20260917-0006", "IN-11:TX-0917-00003", "IN-11:TX-0917-00004",
+       "IN-11:TX-0917-00005", "IN-11:TX-0917-00006"}

--- uc042_e/frontend/src/lib/labels.ts	1970-01-01 05:30:00.000000000 +0530
+++ uc042_token_optimisation/frontend/src/lib/labels.ts	2026-11-16 12:21:55.814298000 +0530
@@ -0,0 +1,41 @@
+// Business-facing labels (DEF-07) and analyst-readable AI failure explanations (DEF-10). Labels describe what the
+// deterministic check tests; they never state a cause. Unknown codes fall back to the code itself, never to a guess.
+
+/** Engine check / exception category codes -> a plain-language name of what the check found. */
+export const CHECK_LABELS: Record<string, string> = {
+  "C11-BATCH-BANK": "Settlement batch not matched to its bank movement",
+  "C11-BATCH-ARITH": "Settlement batch arithmetic does not add up",
+  "C11-BANK-ENTRY": "Bank entry with no settlement counterpart",
+  "CASH-BANK-LINK": "Cash-book entry not matched to a bank entry",
+  "BANK-CASH-LINK": "Bank entry not matched to the cash book",
+  "CBAL-ROLLFWD": "Client balance roll-forward does not agree",
+  "C04-REQUIREMENT": "Safeguarding requirement does not agree",
+  "BC-VS-EOD": "17:00 balance confirmation differs from the end-of-day statement",
+  "C07-BANK-EVIDENCE": "Bank evidence not available for the reconciliation day",
+  "DQ23-STATEMENT": "Bank statement data-quality issue",
+  "FUND-TOPUP": "Own-funds top-up not matched",
+  "UNMATCHED_CASHBOOK_ENTRY": "Cash-book entry with no bank counterpart",
+};
+
+const CODE = /^[A-Z0-9]+([-_][A-Z0-9]+)+$/;
+
+/** The exception's business label: its category when it is already prose, else the mapped check label. */
+export function exceptionLabel(category: string | null | undefined, controlName?: string | null): string {
+  if (category && !CODE.test(category)) return category;
+  if (category && CHECK_LABELS[category]) return CHECK_LABELS[category];
+  return controlName || category || "Exception";
+}
+
+/** Plain-language explanation of a failed or refused AI investigation; the technical text is kept for debugging. */
+export function readableFailure(technical: string | null | undefined): string {
+  const t = (technical || "").toLowerCase();
+  if (t.includes("max_output_tokens")) return "The AI's answer reached its output limit before it was complete, so nothing was published. Retry the investigation, or exclude the exception at the final review with a reason.";
+  if (t.includes("unverified candidate relationship")) return "The AI cited an unverified candidate relationship as confirmed evidence. The application refused the output; candidates may only be discussed as hypotheses.";
+  if (t.includes("states a cause")) return "The AI's output stated a cause as a confirmed fact, which the rules refuse. Nothing was published.";
+  if (t.includes("input_token_budget")) return "The evidence was too large for one request, so no request was sent.";
+  if (t.includes("model_unavailable") || t.includes("model_not_found")) return "The configured AI model is not available to this account. No investigation was produced.";
+  if (t.includes("rate_limit") || t.includes("429")) return "The AI provider refused the request (rate limit or exhausted credits). No investigation was produced.";
+  if (t.includes("timeout")) return "The AI request timed out. No investigation was produced.";
+  if (t.includes("validation") || t.includes("refused") || t.includes("rejected")) return "The AI's output did not pass the application's validation, so it was not published.";
+  return "The AI investigation did not produce a usable result.";
+}

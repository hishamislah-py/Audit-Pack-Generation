+++ b/tests/test_phase2_closing_summary.py
@@ -0,0 +1,102 @@
+"""Phase 2 (PROPOSED; final_pack is guard-protected): closing-summary correctness.
+
+2A  A demonstrably clean pack (engine CLEAN, no exception, no missing-evidence item, no investigation) offers its pack_id as
+    the only citable reference, so pack-level observations can be validly cited. Packs with exceptions or missing evidence
+    are unchanged (pack_id is NOT citable there). Unknown or blank references are still refused.
+2B  The summary prompt names every causal phrase the validation refuses; causal wording is still refused; neutral wording
+    passes. Validation is unchanged throughout.
+Run: python -m unittest tests.test_phase2_closing_summary -v"""
+import re
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from tests.final_pack_support import PACK, make_investigation, summary_output
+from uc042lib.final_pack import build_review_snapshot, closing_summary_input, default_selections, load_pack, validate_closing_summary
+from uc042lib.final_pack.summary import SUMMARY_INSTRUCTIONS
+from uc042lib.investigation.validation import CAUSE_PATTERNS
+
+
+def snapshot_input(scenario, investigate=()):
+    tmp = Path(tempfile.mkdtemp())
+    root = tmp / "investigations"
+    for exc in investigate:
+        make_investigation(scenario, exc, root)
+    snap = build_review_snapshot(PACK[scenario], default_selections(load_pack(PACK[scenario]), root), investigations_root=root)
+    return tmp, closing_summary_input(snap)
+
+
+class CleanPack(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp, cls.input = snapshot_input("S01")
+
+    @classmethod
+    def tearDownClass(cls):
+        shutil.rmtree(cls.tmp)
+
+    def test_clean_pack_offers_only_its_pack_id(self):
+        self.assertEqual(self.input["reconciliation"]["engine_case_status"], "CLEAN")
+        self.assertEqual(self.input["allowed_refs"], [self.input["pack_id"]])
+
+    def test_pack_level_observation_citing_the_pack_is_valid(self):
+        pid = self.input["pack_id"]
+        out = summary_output(self.input, lambda d: d.update(key_observations=[
+            {"text": "The deterministic engine reports every control as passed or not applicable for the period.", "source_refs": [pid]}]))
+        self.assertEqual(validate_closing_summary(out, self.input), [])
+
+    def test_blank_or_unknown_references_are_still_refused(self):
+        for bad in ([" "], ["PACK-NOT-THIS-ONE"], ["EXC-CASE-01"]):
+            out = summary_output(self.input, lambda d, b=bad: d.update(key_observations=[
+                {"text": "The deterministic engine reports every control as passed.", "source_refs": b}]))
+            self.assertTrue(any("references not in the supplied input" in e for e in validate_closing_summary(out, self.input)), bad)
+
+
+class PacksWithExceptionsUnchanged(unittest.TestCase):
+    def test_pack_id_not_citable_when_exceptions_exist(self):
+        tmp, inp = snapshot_input("SC5A", ["EXC-SC5A-01"])
+        try:
+            self.assertNotIn(inp["pack_id"], inp["allowed_refs"])
+            out = summary_output(inp, lambda d: d.update(key_observations=[{"text": "A pack-level statement cited to the pack.", "source_refs": [inp["pack_id"]]}]))
+            self.assertTrue(any("references not in the supplied input" in e for e in validate_closing_summary(out, inp)))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_insufficient_evidence_pack_is_not_treated_as_clean(self):
+        tmp, inp = snapshot_input("S02")
+        try:
+            self.assertNotEqual(inp["reconciliation"]["engine_case_status"], "CLEAN")
+            self.assertNotIn(inp["pack_id"], inp["allowed_refs"])
+            self.assertTrue(set(inp["allowed_refs"]) >= {x["exception_id"] for x in inp["exceptions"]})
+        finally:
+            shutil.rmtree(tmp)
+
+
+class CausalWording(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp, cls.input = snapshot_input("SC5A", ["EXC-SC5A-01"])
+
+    @classmethod
+    def tearDownClass(cls):
+        shutil.rmtree(cls.tmp)
+
+    def test_prompt_names_every_refused_causal_phrase(self):
+        rule = next(line for line in SUMMARY_INSTRUCTIONS.split("\n- ") if line.startswith("Causal wording is refused"))
+        quoted = re.findall(r'"([^"]+)"', rule)
+        for p in CAUSE_PATTERNS:
+            self.assertTrue(any(re.search(p, q, re.I) for q in quoted), p)
+
+    def test_because_of_is_still_refused_and_neutral_wording_passes(self):
+        ref = self.input["exceptions"][0]["exception_id"]
+        bad = summary_output(self.input, lambda d: d.update(key_observations=[
+            {"text": "The roll-forward fails because of the missing transaction.", "source_refs": [ref]}]))
+        self.assertTrue(any("states a cause ('because of')" in e for e in validate_closing_summary(bad, self.input)))
+        good = summary_output(self.input, lambda d: d.update(key_observations=[
+            {"text": "The roll-forward fails, and the transaction referenced by the settlement line is not in the supplied data.", "source_refs": [ref]}]))
+        self.assertEqual([e for e in validate_closing_summary(good, self.input) if "cause" in e], [])
+
+
+if __name__ == "__main__":
+    unittest.main()

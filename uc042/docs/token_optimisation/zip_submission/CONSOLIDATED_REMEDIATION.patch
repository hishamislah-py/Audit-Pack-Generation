+/** Work still open across all months: final reviews awaiting a decision, and the recent activity log. */
+function WorkInProgress() {
+  const data = useData();
+  const reviews = useApi(() => data.reviews(), [data]);
+  const activity = useApi(() => (data.capabilities.activity ? data.activity() : Promise.resolve([])), [data]);
+  const pending = (reviews.data ?? []).filter((r) => PENDING_REVIEW.includes(r.status));
+  return (
+    <div className="grid-2">
+      <Panel title="Final reviews in progress" meta="All months" flush>

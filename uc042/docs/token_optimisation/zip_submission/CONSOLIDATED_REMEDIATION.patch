+} from "../api/types";
+import { Amount, Async, Empty, Kpis, Loading, Notice, Panel, StatusBadge, UnresolvedTag } from "../components/common";
+import { AiStatus, AnalystStatusBadge } from "../components/workspace/AnalystReview";
+import { AutoInvestigationsPanel } from "../components/workspace/AutoInvestigations";
+import { usePage } from "../components/layout/workContext";

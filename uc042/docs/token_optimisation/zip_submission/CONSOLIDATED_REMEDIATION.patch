+// Reassessment of a published month, read-only: the backend's plan and the period's pack lineage. The Reassess action
+// belonged to the retired individual-document workflow (ZIP-only operation, 17 Nov 2026). Published packs are never changed.
+import { Link } from "react-router-dom";
+import { useData } from "../../data/DataProvider";
+import { periodLabel } from "../../data/periods";
+import { useApi } from "../../hooks/useApi";
+import { dateTime } from "../../lib/format";
+import { Async, Empty, KeyValue, Notice, Panel } from "../common";
+
+export function ReassessmentPanel({ periodId }: { periodId: string }) {
+  const data = useData();
+  const plan = useApi(() => data.reassessmentPlan(periodId), [data, periodId]);
+  return (
+    <Panel id="reassessment" title="Reassessment (historical, read-only)" sub="Reassessment belongs to the retired individual-document workflow: the plan and the lineage of earlier reassessments stay readable; nothing can be started here">
+      <Async state={plan} label="Reading the reassessment record…">{(p) => (
+        <div className="stack stack--sm">
+          <KeyValue items={[
+            ["Latest legacy final pack", p.latest_final_pack_id ? <><Link className="id" to={`/final-packs/${p.latest_final_pack_id}`}>{p.latest_final_pack_id}</Link> · {dateTime(p.latest_final_pack_at)}</> : "none"],
+            ["Pack it would reassess", p.target_pack_id ? <Link className="id" to={`/packs/${p.target_pack_id}`}>{p.target_pack_id}</Link> : "—"],
+            ["Evidence received after publication", `${p.new_documents.length} document(s)`],
+          ]} />
+          <Notice tone="info">A new audit of {periodLabel(periodId)} is one complete ZIP package: <Link to={`/submit?period=${periodId}`}>Submit a ZIP package</Link>.
+            Every submission is independent and never changes a published pack.</Notice>
+        </div>
+      )}</Async>
+      <Lineage periodId={periodId} tick={0} />
+    </Panel>
+  );
+}
+
+function Lineage({ periodId, tick }: { periodId: string; tick: number }) {
+  const data = useData();
+  const rows = useApi(() => data.periodLineage(periodId), [data, periodId, tick]);
+  return (
+    <div style={{ marginTop: 16 }}>
+      <div className="section-label">Pack lineage</div>
+      <Async state={rows}>{(r) => r.length === 0 ? <Empty>No reassessment yet: every pack of this month is an original result.</Empty> : (
+        <table className="dtable dtable--compact">
+          <thead><tr><th>Reassessed pack</th><th>Reassesses</th><th>What changed</th><th>Reason</th><th>Recorded</th></tr></thead>
+          <tbody>{r.map((x) => {
+            const c = x.change_summary;
+            return (
+              <tr key={x.pack_id}><td><Link className="id" to={`/packs/${x.pack_id}`}>{x.pack_id}</Link></td>
+                <td><Link className="id" to={`/packs/${x.predecessor_pack_id}`}>{x.predecessor_pack_id}</Link></td>
+                <td className="xsmall">Inputs changed: {c.inputs_changed?.length ? c.inputs_changed.join(", ") : "none"}
+                  {c.exceptions && <div>Exceptions {c.exceptions.before} → {c.exceptions.after}{c.exceptions.added.length ? ` (new: ${c.exceptions.added.join(", ")})` : ""}{c.exceptions.removed.length ? ` (gone: ${c.exceptions.removed.join(", ")})` : ""}</div>}
+                  {c.engine_case_status && <div>Engine status {c.engine_case_status[0]} → {c.engine_case_status[1]}</div>}</td>
+                <td className="xsmall">{x.reason}</td><td className="xsmall nowrap">{dateTime(x.recorded_at)}</td></tr>
+            );
+          })}</tbody>
+        </table>
+      )}</Async>
+    </div>
+  );
+}

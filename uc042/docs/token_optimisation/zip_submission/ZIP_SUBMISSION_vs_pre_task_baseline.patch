+// Independent ZIP submissions (approved 17 Nov 2026). One ZIP holds one complete document set for one month:
+// Upload ZIP -> Validate (inventory and completeness report) -> Submit for Audit (only when the package passed) -> Audit result
+// with the submission identity -> Final pack with its generation time and traceability. Every Submit for Audit is a new
+// submission with a new audit run, also for a package identical to an earlier one; nothing is inherited from earlier
+// packages, uploads, runs or final packs. The completeness rules are the backend's; these screens only present them.
+import { useRef, useState } from "react";
+import { Link, useNavigate, useSearchParams } from "react-router-dom";
+import { errorMessage } from "../api/client";
+import type { AiConfirmation, BatchDetail, PackageGate, PackageHistory, PackageReport, SubmissionEntry } from "../api/types";
+import { AutoInvestigationDisclosure } from "../components/ai/AutoInvestigationDisclosure";
+import { Async, Empty, Kpis, Notice, Panel, StatusBadge } from "../components/common";
+import { usePage } from "../components/layout/workContext";

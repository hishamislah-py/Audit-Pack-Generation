+  const report = (b.summary.package ?? {}) as PackageReport;
+  const gate = report.gate;
+  const history = useApi(() => data.submissions(b.period_id), [data, b.period_id, b.status, detail.runs.length]);
+  const own = history.data?.find((p) => p.batch_id === b.batch_id);
+  const active = detail.runs.find((r) => r.status === "QUEUED" || r.status === "RUNNING");
+  useJobPoller(active?.job_id, () => { reload(); history.reload(); });
+  const [auto, setAuto] = useState<AiConfirmation | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<unknown>();
+  const submissions = own?.submissions ?? [];
+  const step = !gate?.passed ? 1 : !submissions.length ? 2 : submissions.some((s) => s.final_packs?.length) ? 4 : 3;
+  const submit = async () => {
+    setBusy(true);
+    setError(undefined);
+    try { await data.submitPackage(b.batch_id, auto ?? undefined); reload(); history.reload(); } catch (e) { setError(e); } finally { setBusy(false); }
+  };
+  return (
+    <div className="stack">
+      <div className="page-head"><div><div className="eyebrow">ZIP submission package · <Link to={`/reports/${b.period_id}`}>{periodLabel(b.period_id)}</Link></div>
+        <h1 className="page-title mono">{b.batch_id}</h1>
+        <p className="page-sub"><code>{report.zip_name}</code> · {kb(report.zip_bytes ?? 0)} · SHA-256 <span className="mono">{shortHash(report.zip_sha256 ?? "")}</span> ·
+          uploaded {dateTime(b.created_at)} by {b.created_by} · status <StatusBadge status={b.status} /></p></div></div>
+      <SubmissionSteps current={step} />
+      <div className="grid-final">
+        <div className="stack">
+          <Panel title="Validation report"><PackageGateReport gate={gate} report={report} types={types} /></Panel>
+          <Panel title="Submissions of this package" meta={`${submissions.length}`} flush>
+            <Async state={history}>{() => <SubmissionTable rows={submissions} />}</Async>
+          </Panel>
+        </div>
+        <div className="stack">
+          <Panel title="Submit for Audit">
+            <div className="stack stack--sm">
+              {active ? <Notice tone="info">Audit run {active.run_id} is {active.status.toLowerCase()}…</Notice> : gate?.passed ? (
+                <>
+                  <AutoInvestigationDisclosure onReady={setAuto} />
+                  <button className="btn btn--primary" disabled={busy || !auto} onClick={submit}>{submissions.length ? "Submit for Audit again" : "Submit for Audit"}</button>
+                  <p className="xsmall muted">Each submission gets its own submission ID and audit run, even when the documents are identical to an earlier submission.
+                    Identical documents give the same deterministic result; reviews, analyst decisions and final packs are kept per submission.</p>
+                </>
+              ) : <Notice tone="warn" title="Submit for Audit is disabled">The package did not pass validation. Correct the ZIP and upload it again as a new package.</Notice>}
+              {error ? <Notice tone="bad">{errorMessage(error)}</Notice> : null}
+              <Link className="small" to={`/submissions?period=${b.period_id}`}>All submissions for {periodLabel(b.period_id)}</Link>
+            </div>
+          </Panel>
+          {detail.documents.length > 0 && <Panel title="Documents in this package" meta={`${detail.documents.length}`} flush>
+            <table className="dtable dtable--compact"><tbody>{detail.documents.map((d) => (
+              <tr key={d.document_id}><td><code>{d.original_filename}</code></td><td className="id">{d.evidence_id ?? "unidentified"}</td>
+                <td><StatusBadge status={d.validation_status} /></td></tr>))}</tbody></table>
+          </Panel>}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/** Submission history of one month: every ZIP package with its submissions, newest package first. */
+export function SubmissionsPage() {
+  const data = useData();
+  const [params, setParams] = useSearchParams();
+  const periods = useApi(() => data.periods(), [data]);
+  const periodId = params.get("period") ?? periods.data?.find((p) => p.archive)?.period_id ?? "";
+  const history = useApi(() => (periodId ? data.submissions(periodId) : Promise.resolve([] as PackageHistory[])), [data, periodId]);
+  usePage([{ label: "ZIP submissions" }, { label: periodLabel(periodId) }], periodId ? { periodId } : {});
+  return (
+    <div className="stack">
+      <div className="page-head"><div><div className="eyebrow">Independent submissions</div><h1 className="page-title">ZIP submissions · {periodLabel(periodId)}</h1>
+        <p className="page-sub">Every package and every submission is kept as its own record. Earlier final packs are never changed.</p></div>
+        <div className="actions"><Link className="btn btn--primary" to={`/submit${periodId ? `?period=${periodId}` : ""}`}>Submit a ZIP package</Link></div></div>
+      <Async state={periods}>{(rows) => (
+        <label className="field"><span>Month</span>
+          <select className="select" value={periodId} onChange={(e) => setParams({ period: e.target.value })}>
+            {rows.map((p) => <option key={p.period_id} value={p.period_id}>{p.label}</option>)}</select></label>
+      )}</Async>
+      <Async state={history}>{(pkgs) => pkgs.length === 0 ? <Panel><Empty title="No ZIP package yet">No package has been uploaded for this month.</Empty></Panel> : (
+        <div className="stack">{pkgs.map((p) => (
+          <Panel key={p.batch_id} title={<><Link className="mono" to={`/uploads/${p.batch_id}`}>{p.batch_id}</Link> · <code>{p.zip_name}</code></>}
+            meta={<>{dateTime(p.created_at)} · <StatusBadge status={p.gate?.passed ? "PASSED" : "FAILED"} label={p.gate?.passed ? "Validation passed" : "Not accepted"} /> ·
+              {" "}SHA-256 <span className="mono">{shortHash(p.zip_sha256 ?? "")}</span></>} flush>
+            <SubmissionTable rows={p.submissions} />
+          </Panel>
+        ))}</div>
+      )}</Async>
+    </div>
+  );
+}

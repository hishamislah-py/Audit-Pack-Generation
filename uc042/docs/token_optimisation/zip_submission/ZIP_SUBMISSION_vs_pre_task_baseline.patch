--- C:\Users\ARTLPT~1\AppData\Local\Temp/claude/bb4d696e268c5499/0d3429e0-ad8c-40f8-b4ae-9c9a2d667fda/scratchpad/baseline_pre_zip/tests/rule_history.py	1970-01-01 05:30:00.000000000 +0530
+++ tests/rule_history.py	2026-11-17 12:44:38.542420500 +0530
@@ -0,0 +1,16 @@
+"""Engine rules as they stood when the stored (immutable) packs were published, for the reproducibility tests.
+
+Packs published before 17 Nov 2026 record a reconciled zero difference in C06-DIFFERENCE / C08-DIFFERENCE as
+NOT_APPLICABLE; the approved rule since then is PASS (uc042lib.validate.ZERO_DIFFERENCE_OUTCOME). Stored packs are never
+rewritten, so a test that proves "the current code reproduces the stored pack" rebuilds it under the rule it was
+published with. Nothing else is changed by this context."""
+from contextlib import contextmanager
+from unittest import mock
+
+from uc042lib import validate
+
+
+@contextmanager
+def published_zero_difference_rule():
+    with mock.patch.object(validate, "ZERO_DIFFERENCE_OUTCOME", validate.LEGACY_ZERO_DIFFERENCE_OUTCOME):
+        yield

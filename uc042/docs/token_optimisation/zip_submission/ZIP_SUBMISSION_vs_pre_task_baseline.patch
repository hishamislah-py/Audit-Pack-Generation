+import { useData } from "../data/DataProvider";
+import { periodLabel } from "../data/periods";
+import { useApi } from "../hooks/useApi";
+import { useJobPoller } from "../hooks/useJobPoller";
+import { dateTime, shortHash } from "../lib/format";
+
+const STEPS = ["Upload ZIP", "Validate", "Submit for Audit", "Audit result", "Final pack"];
+
+export function SubmissionSteps({ current }: { current: number }) {
+  return (
+    <ol className="steps-bar" aria-label="ZIP submission steps">
+      {STEPS.map((s, i) => <li key={s} className={`steps-bar__step${i < current ? " steps-bar__step--done" : i === current ? " steps-bar__step--current" : ""}`}
+        aria-current={i === current ? "step" : undefined}>{i + 1}. {s}</li>)}
+    </ol>
+  );
+}
+
+/** Upload one ZIP package for a month. Nothing is processed: the package is validated and the report shown on its page. */
+export function SubmitZipPage() {
+  const data = useData();
+  const navigate = useNavigate();
+  const [params, setParams] = useSearchParams();
+  const periods = useApi(() => data.periods(), [data]);
+  const current = periods.data?.find((p) => p.is_current_month);
+  const periodId = params.get("period") ?? current?.period_id ?? "";
+  const period = periods.data?.find((p) => p.period_id === periodId);
+  const [file, setFile] = useState<File | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<unknown>();
+  const input = useRef<HTMLInputElement>(null);
+  usePage([{ label: "Submit a ZIP package" }, { label: periodLabel(periodId) }], periodId ? { periodId } : {});
+
+  const send = async () => {
+    if (!period || !file) return;
+    setBusy(true);
+    setError(undefined);
+    try {
+      if (!period.archive) await data.openPeriod(period.year, period.month);
+      const d = await data.uploadPackage(period.period_id, file);
+      navigate(`/uploads/${d.batch.batch_id}`);
+    } catch (e) { setError(e); setBusy(false); }
+  };
+
+  if (!data.capabilities.upload) return <Notice tone="info" title="Backend required">ZIP submissions are validated and audited by the backend. Start the app with
+    VITE_DATA_SOURCE=api and the backend running.</Notice>;
+  return (
+    <div className="stack">
+      <div className="page-head"><div><div className="eyebrow">Independent submission</div><h1 className="page-title">Submit a ZIP package</h1>
+        <p className="page-sub">One ZIP holds one complete document set for one month. It is checked on its own: nothing is taken from earlier uploads,
+          packages or audit runs. Submit for Audit is a separate step after validation.</p></div></div>
+      <SubmissionSteps current={file ? 1 : 0} />
+      <div className="grid-final">
+        <div className="stack">
+          <Panel title="1. Month">
+            <Async state={periods}>{(rows) => (
+              <label className="field"><span>Month</span>
+                <select className="select" value={periodId} onChange={(e) => { setParams({ period: e.target.value }); setError(undefined); }}>
+                  {rows.map((p) => <option key={p.period_id} value={p.period_id}>{p.label}</option>)}
+                </select></label>
+            )}</Async>
+          </Panel>
+          <Panel title="2. ZIP package">
+            <div className="stack stack--sm">
+              <div className="dropzone" role="button" tabIndex={0} onClick={() => input.current?.click()}
+                onKeyDown={(e) => (e.key === "Enter" || e.key === " ") && input.current?.click()}
+                onDragOver={(e) => e.preventDefault()} onDrop={(e) => { e.preventDefault(); setFile(e.dataTransfer.files[0] ?? null); }}>
+                <div className="strong">Drop one ZIP file here, or click to choose</div>
+                <div className="small">The file names inside must follow the UC-042 convention for {periodLabel(periodId)} (IN-01 to IN-19).</div>
+                <input ref={input} type="file" accept=".zip,application/zip" className="sr-only" aria-label="Choose a ZIP file"
+                  onChange={(e) => { setFile(e.target.files?.[0] ?? null); e.target.value = ""; }} />
+              </div>
+              {file && <p className="small"><code>{file.name}</code> <span className="xsmall muted">{kb(file.size)}</span>{" "}
+                <button className="link-btn" onClick={() => setFile(null)}>Remove</button></p>}
+            </div>
+          </Panel>
+        </div>
+        <div className="stack">
+          <Panel title="3. Validate">
+            <div className="stack stack--sm">
+              <button className="btn btn--primary" disabled={busy || !period || !file} onClick={send}>{busy ? "Uploading…" : "Upload and validate"}</button>
+              <ul className="xsmall muted">
+                <li>Every file must be one of the 19 UC-042 document types for this month. Any other file, a nested ZIP or an unsafe path rejects the whole package.</li>
+                <li>All 17 required types must be present exactly once, readable, and identified the same way by file name and by content. IN-18 and IN-19 are optional; IN-04 and IN-14 may be empty.</li>

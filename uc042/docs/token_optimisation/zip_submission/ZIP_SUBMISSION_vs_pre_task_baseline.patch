+// The analyst's own decision on the selected AI investigation (ACCEPT / REJECT), directly below the AI findings in the
+// Exception Workspace, and the exception's read-only review history. The decision is the analyst's, shown apart from the
+// AI's assessment; it never resolves the exception or changes the investigation. A rejection needs a reason, which is
+// saved exactly as typed and becomes the review content of the final audit pack (the backend enforces this too).
+import { useState } from "react";
+import { ApiError } from "../../api/client";
+import type { AnalystReview, ExceptionInvestigations, ExceptionReviewHistory, PublishedInvestigation, ReviewHistoryEvent } from "../../api/types";
+import { useData } from "../../data/DataProvider";
+import { useApi } from "../../hooks/useApi";
+import { dateTime, shortHash } from "../../lib/format";
+import { Async, Empty, ErrorPanel, Notice, StatusBadge } from "../common";
+
+export type AnalystStatus = "ACCEPTED" | "REJECTED" | "PENDING_REVIEW" | "NOT_INVESTIGATED";
+
+/** The analyst review status of an investigation row (or of an exception without one). */
+export function analystStatus(row: PublishedInvestigation | undefined): AnalystStatus {
+  if (!row) return "NOT_INVESTIGATED";
+  if (!row.analyst_review) return "PENDING_REVIEW";
+  return row.analyst_review.decision === "ACCEPT" ? "ACCEPTED" : "REJECTED";
+}
+
+const STATUS_LABEL: Record<AnalystStatus, string> = {
+  ACCEPTED: "Accepted by analyst", REJECTED: "Rejected by analyst", PENDING_REVIEW: "Findings ready for review", NOT_INVESTIGATED: "No AI to review",
+};
+
+export function AnalystStatusBadge({ row }: { row: PublishedInvestigation | undefined }) {
+  const s = analystStatus(row);
+  return <StatusBadge status={s} label={STATUS_LABEL[s]} />;
+}
+
+/** The investigation the analyst reviews by default (and the final review includes): the first eligible one, else the newest. */
+export function defaultInvestigation(row: ExceptionInvestigations | undefined): PublishedInvestigation | undefined {
+  return row ? row.published.find((p) => p.eligible) ?? row.published[0] : undefined;
+}
+
+/** One plain-language status of an exception's AI assistance: never run, running, usable (with the analyst's decision),
+ * or only investigations that cannot be used in a final audit pack. The AI assessment itself is shown elsewhere. */
+export function AiStatus({ row }: { row: ExceptionInvestigations | undefined }) {
+  if (row?.active_jobs.length) return row.active_jobs[0].status === "QUEUED" ? <StatusBadge status="QUEUED" label="Queued" />
+    : <StatusBadge status="RUNNING" label="Investigation in progress" />;
+  const usable = row?.published.filter((p) => p.eligible) ?? [];
+  const accepted = usable.find((p) => p.analyst_review?.decision === "ACCEPT");
+  if (accepted) return <AnalystStatusBadge row={accepted} />;
+  const pending = usable.find((p) => !p.analyst_review);
+  if (pending) return <AnalystStatusBadge row={pending} />;
+  if (usable.length) return <AnalystStatusBadge row={usable[0]} />;
+  if (row?.not_published.length && !row.published.length) return <StatusBadge status="FAILED" label="Investigation failed — reason available" />;
+  if (row?.published.length) return <StatusBadge status="INTERRUPTED" label={`Not usable (${row.published.length})`} />;
+  return <StatusBadge status="NOT_RUN" label="Not investigated" />;
+}
+
+function Decision({ review }: { review: AnalystReview }) {
+  const rejected = review.decision === "REJECT";
+  return (
+    <div className={`analyst-decision analyst-decision--${rejected ? "rejected" : "accepted"}`}>
+      <div className="row"><StatusBadge status={rejected ? "REJECTED" : "ACCEPTED"} label={rejected ? "REJECTED by the analyst" : "ACCEPTED by the analyst"} />
+        <span className="xsmall muted">{review.reviewer.display_name} · {dateTime(review.decided_at)} · revision {review.revision}</span></div>
+      {rejected && <div><div className="finding__field">Reason for rejection</div><div className="verbatim">{review.rejection_reason}</div></div>}
+      {review.comment ? <div><div className="finding__field">Analyst comment{rejected ? " (separate from the reason)" : ""}</div><div className="verbatim">{review.comment}</div></div> : null}
+      {rejected && <p className="xsmall muted">In the final audit pack this exception shows <strong>REJECTED BY ANALYST</strong> with your exact reason; the AI's
+        summary, findings and recommendations are left out. The investigation itself is kept unchanged in its history.</p>}
+      {!!review.pdf_unsupported_characters?.length && <Notice tone="bad" title="The audit PDF cannot draw some characters">
+        {review.pdf_unsupported_characters.map((c) => `${c.character} (${c.codepoint})`).join(", ")}: the final audit pack is blocked until a
+        fallback font covers them or a new decision is recorded. Characters are never substituted.</Notice>}
+      <p className="xsmall faint mono">{review.analyst_review_id} · findings {shortHash(review.findings_sha256)} ({review.findings_schema_version || "schema not recorded"})</p>
+    </div>
+  );
+}
+
+/** ACCEPT / REJECT for the selected investigation. Refers to the exact published investigation and its findings version. */
+export function AnalystReviewSection({ investigationId, row, onRecorded, submissionId, scopedCurrent }: {
+  investigationId: string; row: PublishedInvestigation | undefined; onRecorded: (r: AnalystReview) => void;
+  /** A ZIP submission's review: the decision is recorded for that submission only; scopedCurrent is its active decision there. */
+  submissionId?: string; scopedCurrent?: AnalystReview | null;
+}) {
+  const data = useData();
+  const current = submissionId ? scopedCurrent ?? null : row?.analyst_review ?? null;
+  const scope = submissionId ? { submission_id: submissionId } : {};
+  const [choice, setChoice] = useState<"ACCEPT" | "REJECT" | null>(null);
+  const [comment, setComment] = useState("");
+  const [reason, setReason] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<unknown>();
+  const blankReason = reason.trim().length === 0;
+  const canSave = choice === "ACCEPT" || (choice === "REJECT" && !blankReason);
+  const reset = () => { setChoice(null); setComment(""); setReason(""); setError(undefined); };
+
+  const save = async () => {
+    if (!choice || !canSave) return;
+    setBusy(true);
+    setError(undefined);
+    try {
+      const r = await data.recordAnalystReview(investigationId, choice === "REJECT"
+        ? { decision: "REJECT", rejection_reason: reason, comment, expected_revision: current?.revision ?? 0, ...scope }
+        : { decision: "ACCEPT", comment, expected_revision: current?.revision ?? 0, ...scope });
+      reset();
+      onRecorded(r);
+    } catch (e) {
+      setError(e);
+    } finally {
+      setBusy(false);
+    }
+  };
+  const conflict = error instanceof ApiError && error.code === "REVIEW_DECISION_CONFLICT";
+
+  return (
+    <section className="analyst-review" aria-label="Analyst review" id="analyst-review">
+      <header className="analyst-review__head">
+        <h3 className="analyst-review__title">Analyst review</h3>
+        <span className="xsmall muted">Your decision on <span className="mono">{investigationId}</span> · separate from the AI's assessment</span>
+      </header>
+      {current ? <Decision review={current} /> : <Notice tone="warn">Pending analyst review: this investigation has not been accepted or rejected. A pending
+        investigation is never treated as accepted in the final audit pack.</Notice>}
+      {row && !row.eligible ? <Notice tone="info" title="No decision needed for this investigation">It cannot be used in the final audit pack
+        ({row.ineligible_reasons[0] ?? "not eligible"}), so accepting or rejecting it would change nothing. Review an eligible investigation of this
+        exception, retry the investigation, or exclude it from the final pack with a reason in the final review (Investigation selections → Edit).</Notice>
+      : !data.capabilities.realInvestigations ? <p className="xsmall muted">Analyst decisions are recorded by the backend (not available with mock data).</p> : (
+        <>
+          <div className="analyst-review__choices" role="radiogroup" aria-label="Analyst decision">
+            {(["ACCEPT", "REJECT"] as const).map((d) => (
+              <button key={d} type="button" role="radio" aria-checked={choice === d}
+                className={`btn btn--sm${choice === d ? (d === "ACCEPT" ? " btn--accept" : " btn--reject") : ""}`}
+                onClick={() => { setChoice(d); setError(undefined); }} disabled={busy}>
+                {d === "ACCEPT" ? (current?.decision === "ACCEPT" ? "Accept again" : "Accept") : (current?.decision === "REJECT" ? "Reject again" : "Reject")}
+              </button>
+            ))}
+          </div>
+          {choice === "ACCEPT" && (
+            <label className="field"><span>Analyst comment (optional)</span>
+              <textarea className="textarea" rows={3} value={comment} maxLength={8000} onChange={(e) => setComment(e.target.value)}
+                placeholder="For example: agrees with the bank statement and the cash book" /></label>
+          )}
+          {choice === "REJECT" && (
+            <div className="field">
+              <label className="field"><span>Reason for rejection</span>
+                <textarea className="textarea" rows={5} value={reason} maxLength={8000} required aria-required="true"
+                  aria-invalid={blankReason} aria-describedby={`reason-help-${investigationId}`} onChange={(e) => setReason(e.target.value)}
+                  placeholder="Required. Saved exactly as written and shown in the final audit report in place of the AI's findings." />
+              </label>
+              <span id={`reason-help-${investigationId}`} className={`xsmall${blankReason ? " bad-text" : " muted"}`}>
+                {blankReason ? "A reason for rejection is required; an empty or blank reason cannot be saved."
+                  : "Saved exactly as written; it replaces the AI's findings in the final audit report."}</span>
+              <label className="field"><span>Analyst comment (optional, kept separately from the reason)</span>
+                <textarea className="textarea" rows={2} value={comment} maxLength={8000} onChange={(e) => setComment(e.target.value)}
+                  placeholder="For example: discussed with the treasury lead" /></label>
+            </div>
+          )}
+          {choice && (
+            <div className="row">
+              <button className="btn btn--primary btn--sm" onClick={save} disabled={busy || !canSave}>
+                {busy ? "Saving…" : choice === "ACCEPT" ? "Save decision: ACCEPT" : "Save decision: REJECT"}</button>
+              <button className="btn btn--sm" onClick={reset} disabled={busy}>Cancel</button>
+            </div>
+          )}
+          {current && choice && <p className="xsmall muted">A new decision is added to the history; the earlier decision and its wording are kept.</p>}
+          <p className="xsmall muted">Neither decision resolves the exception: it stays UNRESOLVED, and the deterministic results and the AI investigation are not changed.</p>
+          {error !== undefined && <ErrorPanel error={error} title={conflict ? "The review changed since you opened it: reload and decide again" : "The decision was not saved"} />}
+        </>
+      )}
+    </section>
+  );
+}
+
+function eventText(e: ReviewHistoryEvent): string | null {
+  const d = e.details;
+  if (e.kind === "ANALYST_DECISION_REJECT") return String(d.rejection_reason ?? "") + (d.comment ? `\n\nComment: ${String(d.comment)}` : "");
+  if (e.kind === "ANALYST_DECISION_ACCEPT") return d.comment ? String(d.comment) : null;
+  if (typeof d.error === "string" && d.error) return d.error;
+  if (typeof d.failure_reason === "string" && d.failure_reason) return d.failure_reason;
+  return null;
+}
+
+/** Chronological, read-only history of the exception's AI investigations and the analyst's decisions. */
+export function ReviewHistoryPanel({ packId, exceptionId, tick }: { packId: string; exceptionId: string; tick: number }) {
+  const data = useData();
+  const state = useApi(() => data.exceptionReviewHistory(packId, exceptionId), [data, packId, exceptionId, tick]);
+  return (
+    <section className="panel" aria-label="Review history">
+      <header className="panel__head"><div><h2 className="panel__title">Review history</h2>
+        <div className="panel__sub">Audit trail of this exception's AI investigations and analyst decisions · read-only · not part of the final audit pack</div></div></header>
+      <Async state={state} label="Loading the review history…">{(h: ExceptionReviewHistory) => h.events.length === 0 ? (
+        <Empty title="No review events yet">No AI investigation has been requested or published for this exception.</Empty>
+      ) : (
+        <ol className="timeline">
+          {h.events.map((e, i) => {
+            const text = eventText(e);
+            const decision = e.kind.startsWith("ANALYST_DECISION_");
+            return (
+              <li key={`${e.kind}-${e.at}-${i}`} className={`timeline__item${decision ? " timeline__item--decision" : ""}`}>
+                <div className="row">
+                  <span className="strong small">{e.label}</span>
+                  {decision && <StatusBadge status={e.details.decision === "REJECT" ? "REJECTED" : "ACCEPTED"} label={String(e.details.decision)} />}
+                  {decision && (e.details.active ? <StatusBadge status="ACTIVE" label="Active decision" /> : <StatusBadge status="SUPERSEDED" label="Superseded" />)}
+                </div>
+                <div className="xsmall muted">{e.at ? dateTime(e.at) : "time not recorded"}
+                  {e.actor ? ` · ${(e.details.reviewer as { display_name?: string } | undefined)?.display_name ?? e.actor}` : ""}
+                  {e.investigation_id ? <> · <span className="mono">{e.investigation_id}</span></> : null}
+                  {typeof e.details.findings_schema_version === "string" && e.details.findings_schema_version ? ` · findings ${e.details.findings_schema_version}` : ""}
+                  {typeof e.details.revision === "number" ? ` · revision ${e.details.revision}` : ""}</div>
+                {text && <div className={decision ? "verbatim small" : "xsmall"}>{text}</div>}
+              </li>
+            );
+          })}
+        </ol>
+      )}</Async>
+      <p className="panel__body xsmall muted">{state.data?.note ?? ""}</p>
+    </section>
+  );
+}

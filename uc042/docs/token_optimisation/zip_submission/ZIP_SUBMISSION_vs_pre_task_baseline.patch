+// Independent ZIP submissions (17 Nov 2026): upload one ZIP, read its validation report, Submit for Audit only when the package
+// passed (a new submission every time), and the submission history with traceable final packs. API-shaped in-memory source.
+import { screen, waitFor, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { describe, expect, it } from "vitest";
+import type { BatchDetail, PackageGate, PackageHistory, PeriodDetail, ProcessingRun } from "../api/types";
+import { MockDataSource } from "../data/mock/MockDataSource";
+import { buildArchivePeriods } from "../data/periods";
+import { diskLoader, FAST, NOW, renderApp } from "./support";
+
+const T = { timeout: 8000 };
+const REQUIRED = ["IN-01", "IN-02", "IN-03", "IN-04", "IN-05", "IN-06", "IN-07", "IN-08", "IN-09", "IN-10", "IN-11", "IN-12", "IN-13", "IN-14", "IN-15", "IN-16", "IN-17"];
+
+function gate(over: Partial<PackageGate> = {}): PackageGate {
+  return { passed: true, present_required: REQUIRED, missing_required: [], present_optional: ["IN-18", "IN-19"], duplicate_types: {}, duplicate_names: [],
+    unexpected: [], unsafe: [], mismatches: [], unusable: [], ignored_metadata: [".DS_Store"], required_total: 17, ...over };
+}
+
+function batch(id: string, g: PackageGate, status: string): BatchDetail {
+  return {
+    batch: { batch_id: id, period_id: "PER-2026-09", origin: "ZIP_SUBMISSION", created_at: "2026-11-17T09:00:00+00:00", created_by: "analyst-1",
+      file_count: g.passed ? 19 : 0, validation_status: g.passed ? "VALID" : "INVALID", status, error: "", confirmed_at: null, confirmed_by: null,
+      summary: { package: { zip_name: "september.zip", zip_sha256: "b".repeat(64), zip_bytes: 40960, gate: g } } },
+    documents: [], runs: [],
+  };
+}
+
+class ZipSource extends MockDataSource {
+  override readonly capabilities = { activity: true, upload: true, realInvestigations: false, realGeneration: false };
+  calls: string[] = [];
+  details: Record<string, BatchDetail> = {
+    "UPL-OK": batch("UPL-OK", gate(), "VALIDATED"),
+    "UPL-BAD": batch("UPL-BAD", gate({ passed: false, present_required: [], missing_required: ["IN-11"],
+      unexpected: [{ name: "notes.txt", reason: "not a file of the approved UC-042 schema (IN-01 to IN-19) for this period" }],
+      duplicate_types: { "IN-17": ["safeguarding_reconciliation_policy_v1.2.pdf", "safeguarding_reconciliation_policy_v1.1.pdf"] } }), "PACKAGE_REJECTED"),
+  };
+  history: PackageHistory[] = [];
+  n = 0;
+
+  constructor() { super(diskLoader, FAST, () => NOW); }
+  override async periods() { return buildArchivePeriods([], await this.packs(), new Date(NOW)); }
+  override archivePeriod(): Promise<PeriodDetail> {
+    return Promise.reject(new Error("not needed"));
+  }
+  override openPeriod(year: number, month: number) { this.calls.push(`open ${year}-${month}`); return Promise.resolve({} as never); }
+  override uploadPackage(periodId: string, file: File) { this.calls.push(`package ${periodId} ${file.name}`); return Promise.resolve(this.details["UPL-OK"]); }
+  override batch(id: string) { return Promise.resolve(structuredClone(this.details[id])); }
+  override async submissions() { return structuredClone(this.history); }
+  override submitPackage(batchId: string): Promise<ProcessingRun> {
+    this.n += 1;
+    const sub = `SUB-${String(this.n).padStart(24, "0")}`;
+    const run = `RUN-${String(this.n).padStart(24, "0")}`;
+    this.calls.push(`submit ${batchId} ${sub}`);
+    let pkg = this.history.find((p) => p.batch_id === batchId);
+    if (!pkg) { pkg = { batch_id: batchId, created_at: "2026-11-17T09:00:00+00:00", status: "PROCESSED", zip_name: "september.zip", zip_sha256: "b".repeat(64), gate: gate(), file_count: 19, submissions: [] }; this.history.push(pkg); }
+    pkg.submissions.push({ submission_id: sub, run_id: run, submitted_at: `2026-11-17T09:0${this.n}:00+00:00`, submitted_by: "analyst-1", status: "SUCCEEDED",
+      pack_id: "PACK-CASE-PER-2026-09-abc", outcome: this.n === 1 ? "PUBLISHED" : "ALREADY_EXISTS",
+      final_packs: this.n === 1 ? [{ final_pack_id: "FAP-CASE-PER-2026-09-v1-aaa", generated_at: "2026-11-17T10:00:00+00:00", final_content_sha256: "c".repeat(64) }] : [] });
+    return Promise.resolve({ run_id: run, period_id: "PER-2026-09", batch_id: batchId, job_id: null, status: "SUCCEEDED", started_at: null, completed_at: null,
+      error: "", result: { submission_id: sub }, created_at: "2026-11-17T09:00:00+00:00", created_by: "analyst-1" });
+  }
+}
+
+describe("ZIP submission", () => {
+  it("uploads one ZIP for the month and opens its validation report", async () => {
+    const src = new ZipSource();
+    renderApp("/submit?period=PER-2026-09", src);
+    const send = await screen.findByRole("button", { name: "Upload and validate" }, T);
+    expect(send).toBeDisabled();
+    await userEvent.upload(screen.getByLabelText("Choose a ZIP file"), new File(["PK"], "september.zip", { type: "application/zip" }));
+    await userEvent.click(send);
+    await waitFor(() => expect(src.calls.at(-1)).toBe("package PER-2026-09 september.zip"), T);
+    expect(await screen.findByText("Package complete", undefined, T)).toBeInTheDocument();
+    expect(screen.getByText("17 / 17")).toBeInTheDocument();
+    expect(screen.getByText(/Ignored operating-system files: .DS_Store/)).toBeInTheDocument();
+  });
+
+  it("a rejected package lists every problem with the file names and cannot be submitted", async () => {
+    const src = new ZipSource();
+    renderApp("/uploads/UPL-BAD", src);
+    expect(await screen.findByText("Package not accepted", undefined, T)).toBeInTheDocument();
+    expect(screen.getByText("notes.txt")).toBeInTheDocument();
+    expect(screen.getByText(/Missing required documents/)).toBeInTheDocument();
+    expect(screen.getByText(/Document types supplied more than once/)).toBeInTheDocument();
+    expect(screen.getByText("Submit for Audit is disabled")).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: /Submit for Audit/ })).toBeNull();
+    expect(src.calls).toEqual([]);
+  });
+
+  it("each Submit for Audit is a separate submission, identical documents included; no v1/v2 identity is shown", async () => {
+    const src = new ZipSource();
+    renderApp("/uploads/UPL-OK", src);
+    const submit = await screen.findByRole("button", { name: "Submit for Audit" }, T);
+    await waitFor(() => expect(submit).toBeEnabled(), T); // after the AI disclosure is read
+    await userEvent.click(submit);
+    const again = await screen.findByRole("button", { name: "Submit for Audit again" }, T);
+    await waitFor(() => expect(again).toBeEnabled(), T);
+    await userEvent.click(again);
+    await waitFor(() => expect(src.calls).toEqual([`submit UPL-OK SUB-${"1".padStart(24, "0")}`, `submit UPL-OK SUB-${"2".padStart(24, "0")}`]));
+    const table = await screen.findByRole("table", undefined, T).catch(() => null);
+    expect(table).not.toBeNull();
+    await waitFor(() => expect(screen.getAllByText(/^SUB-0+[12]$/)).toHaveLength(2), T);
+    expect(screen.getByText(/identical documents: the same deterministic result/)).toBeInTheDocument();
+    expect(screen.getByRole("link", { name: "FAP-CASE-PER-2026-09-v1-aaa" })).toBeInTheDocument();
+    const reviewLinks = screen.getAllByRole("link", { name: "Review this submission" });
+    expect(reviewLinks.map((a) => a.getAttribute("href"))).toEqual([
+      `/packs/PACK-CASE-PER-2026-09-abc/review?submission=SUB-${"2".padStart(24, "0")}`,
+      `/packs/PACK-CASE-PER-2026-09-abc/review?submission=SUB-${"1".padStart(24, "0")}`]);
+    // the protected final-pack ID keeps its format; no separate v1 / v2 / "Version" identity is shown
+    expect(screen.queryByText(/^v\d+$|Version/)).toBeNull();
+  });
+
+  it("the period's submission history keeps every package and submission", async () => {
+    const src = new ZipSource();
+    await src.submitPackage("UPL-OK");
+    await src.submitPackage("UPL-OK");
+    renderApp("/submissions?period=PER-2026-09", src);
+    const panel = (await screen.findByRole("link", { name: "UPL-OK" }, T)).closest("section")!;
+    expect(within(panel).getAllByText(/^SUB-0+[12]$/)).toHaveLength(2);
+    expect(within(panel).getByText("Validation passed")).toBeInTheDocument();
+  });
+});

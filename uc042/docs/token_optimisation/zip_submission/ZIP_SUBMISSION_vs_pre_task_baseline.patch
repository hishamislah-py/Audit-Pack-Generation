+      </div>
+    </div>
+  );
+}
+
+function Issues({ title, rows }: { title: string; rows: { name: string; reason: string }[] }) {
+  if (!rows.length) return null;
+  return <Notice tone="bad" title={`${title} (${rows.length})`}><ul>{rows.map((r, i) => <li key={`${r.name}-${i}`}><code>{r.name}</code>: {r.reason}</li>)}</ul></Notice>;
+}
+
+/** The validation report of one package: present, missing, optional, duplicates, unexpected, mismatched and unreadable files. */
+export function PackageGateReport({ gate, report, types }: { gate: PackageGate | undefined; report: PackageReport; types: Record<string, string> }) {
+  if (report.error) return <Notice tone="bad" title="The ZIP could not be read">{report.error.message} <span className="xsmall mono">({report.error.code})</span></Notice>;
+  if (!gate) return null;
+  const label = (id: string) => <><span className="id">{id}</span>{types[id] ? ` · ${types[id]}` : ""}</>;
+  return (
+    <div className="stack stack--sm">
+      {gate.passed ? <Notice tone="ok" title="Package complete">Every required document is present exactly once, readable, and identified the same way by its name and its content.
+        It can be submitted for audit.</Notice>
+        : <Notice tone="bad" title="Package not accepted">{gate.reason ?? "The package does not meet the completeness rules below. Submit for Audit stays disabled; no audit run is created."}</Notice>}
+      <Kpis items={[
+        { label: "Required present", value: `${gate.present_required.length} / ${gate.required_total ?? 17}`, tone: gate.missing_required.length ? "bad" : "sm" },
+        { label: "Optional present", value: gate.present_optional.length, tone: "sm" },
+        { label: "Problems", value: gate.unexpected.length + gate.unsafe.length + gate.mismatches.length + gate.unusable.length
+          + gate.duplicate_names.length + Object.keys(gate.duplicate_types).length, tone: gate.passed ? "sm" : "bad" },
+      ]} />
+      {gate.missing_required.length > 0 && <Notice tone="bad" title="Missing required documents"><ul>{gate.missing_required.map((id) => <li key={id}>{label(id)}</li>)}</ul></Notice>}
+      <Issues title="Unsafe entries" rows={gate.unsafe} />
+      <Issues title="Unexpected files" rows={gate.unexpected} />
+      {gate.duplicate_names.length > 0 && <Notice tone="bad" title="Duplicate file names"><ul>{gate.duplicate_names.map((d) => <li key={d.name}><code>{d.name}</code>: {d.paths.join(", ")}</li>)}</ul></Notice>}
+      {Object.keys(gate.duplicate_types).length > 0 && <Notice tone="bad" title="Document types supplied more than once"><ul>{Object.entries(gate.duplicate_types).map(([id, names]) =>
+        <li key={id}>{label(id)}: {names.map((n) => <code key={n}>{n} </code>)}</li>)}</ul></Notice>}
+      <Issues title="Name and content disagree" rows={gate.mismatches} />
+      {gate.unusable.length > 0 && <Notice tone="bad" title="Unreadable or invalid required documents"><ul>{gate.unusable.map((u) =>
+        <li key={u.name}><code>{u.name}</code>: {u.errors.join("; ")}</li>)}</ul></Notice>}
+      {(gate.optional_not_usable ?? []).length > 0 && <Notice tone="warn" title="Optional documents that cannot be used"><ul>{gate.optional_not_usable!.map((u) =>
+        <li key={u.name}><code>{u.name}</code>: {u.errors.join("; ")}</li>)}</ul></Notice>}
+      {gate.present_required.length > 0 && <details className="small"><summary>Required documents present ({gate.present_required.length})</summary>
+        <ul>{gate.present_required.map((id) => <li key={id}>{label(id)}</li>)}</ul></details>}
+      {gate.present_optional.length > 0 && <details className="small"><summary>Optional documents present ({gate.present_optional.length})</summary>
+        <ul>{gate.present_optional.map((id) => <li key={id}>{label(id)}</li>)}</ul></details>}
+      {gate.ignored_metadata.length > 0 && <p className="xsmall muted">Ignored operating-system files: {gate.ignored_metadata.join(", ")}</p>}
+    </div>
+  );
+}

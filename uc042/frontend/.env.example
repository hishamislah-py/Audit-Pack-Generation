# Data source (explicit; never an automatic fallback):
#   mock = DEVELOPMENT ONLY: captured backend responses (dev-fixtures/mock-data), actions simulated in the browser
#   api  = the local FastAPI backend at VITE_API_BASE_URL (default)
VITE_DATA_SOURCE=api
# Base URL of the local FastAPI backend (python -m uc042app). No secrets belong in this file:
# every VITE_ variable is compiled into the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Request timeout for ordinary API calls (ms). GENERATE uses a longer timeout (it publishes synchronously).
VITE_API_TIMEOUT_MS=30000

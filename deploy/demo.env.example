# UC-042 analyst demo: AI settings. Copy to .runtime\.env (ignored by git) and fill in OPENAI_API_KEY.
# Without this file the application runs with AI investigations OFF (reconciliation, review and audit packs still work).
#
# Only these exact keys are read from this file by the application (smartparser/reconciliation/closure_runner.py,
# AI_ENV_KEYS); every other line is ignored. The key is never logged, printed or written to any output.

OPENAI_API_KEY=

# Optional. Defaults shown; uncomment to change.
# UC042_LLM_PROVIDER=openai                 # the application supports OpenAI only
# UC042_LLM_MODEL=gpt-6-luna                # engine default (uc042/uc042lib/investigation/config.py)
# UC042_LLM_TIMEOUT_SECONDS=120             # per request
# UC042_LLM_MAX_TOKENS=8000                 # max_output_tokens (reasoning tokens count towards it)
# UC042_OPENAI_REASONING_EFFORT=            # unset = not sent

# Not read from this file: application switches are process environment variables (see deploy/README.md):
#   RINGFENCE_ENGINE_RELATIONSHIP_DISCOVERY (start_demo sets "on"), RINGFENCE_AUTO_RECONCILE, RINGFENCE_AI_PARALLEL,
#   RINGFENCE_AI_GROUP_INVESTIGATION, RINGFENCE_AI_CLOSING_SUMMARY, SMARTPARSER_DEFAULT_THEME.
